{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "1320px", "wideSize": "1440px" },
    "spacing": { "blockGap": true, "units": ["px", "em", "rem", "%", "vw"] },
    "color": { "custom": false, "defaultPalette": true, "palette": [
      { "slug": "vetra-basalt-black", "color": "#12161A", "name": "Basalt Black" },
      { "slug": "vetra-architectural-ochre", "color": "#C67D34", "name": "Architectural Ochre" },
      { "slug": "vetra-raw-concrete", "color": "#8A95A5", "name": "Raw Exposed Concrete" },
      { "slug": "vetra-chalk-white", "color": "#F6F7F9", "name": "Chalk Lime White" },
      { "slug": "vetra-brushed-bronze", "color": "#B3803B", "name": "Deep Brushed Bronze" },
      { "slug": "vetra-charcoal-aluminum", "color": "#222933", "name": "Fluted Charcoal Aluminum" }
    ] },
    "typography": { "fluid": true, "fontSizes": [
      { "slug": "small", "size": "0.875rem", "name": "Small" },
      { "slug": "medium", "size": "1.125rem", "name": "Medium" },
      { "slug": "large", "size": "2.25rem", "name": "Large" }
    ] }
  },
  "styles": {
    "spacing": { "blockGap": "1.5rem" },
    "typography": { "fontFamily": "var(--vetra-font)", "lineHeight": "1.8" },
    "elements": {
      "button": { "border": { "radius": "var(--vetra-radius-md, 8px)" }, "color": { "background": "var(--vetra-architectural-ochre)", "text": "var(--vetra-basalt-black)" } },
      "link": { "color": { "text": "var(--vetra-architectural-ochre)" } },
      "heading": { "typography": { "fontWeight": "800", "lineHeight": "1.35" } }
    }
  }
}
